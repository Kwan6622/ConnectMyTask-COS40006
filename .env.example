NODE_ENV=development
PORT=4000

# Neon Singapore PostgreSQL (application traffic uses the pooled endpoint)
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require
# Direct endpoint for Prisma migration tooling only
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:YOUR_NEON_PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require
NEON_BRANCH=your_neon_branch_name

# Cloudinary unsigned upload (frontend)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dgwtzios
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset

# Base URL of external AI service (Python FastAPI)
AI_SERVICE_URL=http://ai-service
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL=gemini-flash-latest

# JWT secret for auth tokens (change in real deployments)
JWT_SECRET=replace_with_a_long_random_secret

# Frontend URL used for payment redirects
FRONTEND_URL=http://localhost:5173

# Stripe sandbox / test mode
STRIPE_SECRET_KEY=sk_test_replace_me
# Optional alias if you follow Stripe docs naming in scripts/tools
STRIPE_TEST_API_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CURRENCY=vnd

