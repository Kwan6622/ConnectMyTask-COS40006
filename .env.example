NODE_ENV=development
PORT=4000

# Neon Singapore PostgreSQL (application traffic uses the pooled endpoint)
DATABASE_URL=postgresql://NEON_USER:NEON_PASSWORD@YOUR_ENDPOINT-pooler.ap-southeast-1.aws.neon.tech/NEON_DATABASE?sslmode=require&channel_binding=require
# Direct endpoint for Prisma migration tooling only
DATABASE_URL_UNPOOLED=postgresql://NEON_USER:NEON_PASSWORD@YOUR_ENDPOINT.ap-southeast-1.aws.neon.tech/NEON_DATABASE?sslmode=require&channel_binding=require

# Cloudinary unsigned upload (frontend)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dgwtzios
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset

# Base URL of external AI service (Python FastAPI)
AI_SERVICE_URL=http://ai-service
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# JWT secret for auth tokens (change in real deployments)
JWT_SECRET=replace_with_a_long_random_secret

# Frontend URL used for payment redirects
FRONTEND_URL=http://localhost:5173

# Stripe sandbox / test mode
STRIPE_SECRET_KEY=your_stripe_test_secret_key
# Optional alias if you follow Stripe docs naming in scripts/tools
STRIPE_TEST_API_KEY=your_stripe_test_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
STRIPE_CURRENCY=vnd

