NODE_ENV=development
PORT=5000

# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/connectmytask?schema=public

# Cloudinary unsigned upload (frontend)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dgwtzios
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset

# Base URL of external AI service (Python FastAPI)
AI_SERVICE_URL=http://ai-service
OPENAI_API_KEY=sk-proj_xxx
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=AIzaSy_xxx
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash

# JWT secret for auth tokens (change in real deployments)
JWT_SECRET=supersecretjwtkey

# Frontend URL used for payment redirects
FRONTEND_URL=http://localhost:5173

# Stripe sandbox / test mode
STRIPE_SECRET_KEY=sk_test_xxx
# Optional alias if you follow Stripe docs naming in scripts/tools
STRIPE_TEST_API_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CURRENCY=vnd

