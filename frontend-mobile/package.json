{
  "name": "connectmytask-mobile",
  "version": "1.0.0",
  "description": "ConnectMyTask Mobile App - React Native with Expo",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --lan",
    "start:tunnel": "expo start --tunnel",
    "android": "node ./scripts/run-android.js",
    "android:lan": "expo start --android --lan",
    "android:native": "expo run:android",
    "ios": "expo start --ios --localhost",
    "ios:lan": "expo start --ios --lan",
    "ios:native": "expo run:ios",
    "ipad": "expo start --tunnel",
    "ipad:lan": "expo start --lan",
    "web": "expo start --web",
    "test": "jest --watch",
    "test:ci": "jest --ci --passWithNoTests",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "prebuild": "expo prebuild --clean"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "~2.2.0",
    "axios": "^1.6.0",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "^57.0.12",
    "expo-location": "~57.0.21",
    "expo-router": "~57.0.25",
    "expo-splash-screen": "^57.0.9",
    "expo-status-bar": "~57.0.1",
    "nativewind": "^2.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "^0.21.0",
    "tailwindcss": "^3.3.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/node": "^25.2.1",
    "@types/react": "~19.2.18",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.0.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=9.0.0"
  }
}
