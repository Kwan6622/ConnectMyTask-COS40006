{
  "name": "connectmytask-mobile",
  "version": "1.0.0",
  "description": "ConnectMyTask Mobile App - React Native with Expo",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "android": "node ./scripts/run-android.js",
    "android:lan": "expo start --android --lan",
    "android:native": "expo run:android",
    "ios": "expo start --ios --localhost",
    "ios:lan": "expo start --ios --lan",
    "ios:native": "expo run:ios",
    "ipad": "expo start --tunnel",
    "ipad:lan": "expo start --lan",
    "web": "expo start --web",
    "test": "jest --watch",
    "test:ci": "jest --ci --passWithNoTests",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "prebuild": "expo prebuild --clean"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "~2.2.0",
    "axios": "^1.6.0",
    "expo": "^58.0.0",
    "expo-constants": "~58.0.13",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.19",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "nativewind": "^2.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "tailwindcss": "^3.3.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/node": "^25.2.1",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "prettier": "^3.0.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=9.0.0"
  }
}
