{
  "expo": {
    "name": "ConnectMyTask",
    "slug": "connectmytask-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.connectmytask.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ConnectMyTask uses your foreground location to verify and share your position on an assigned task while the app is open."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.connectmytask.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "connectmytask",
    "plugins": [
      [
        "expo-router",
        {
          "origin": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ConnectMyTask uses your foreground location to verify and share your position on an assigned task while the app is open."
        }
      ]
    ]
  }
}
